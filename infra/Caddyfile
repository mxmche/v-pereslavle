{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

api.{$DOMAIN} {
	reverse_proxy api:3001
}

admin.{$DOMAIN} {
	encode zstd gzip
	handle_path /api/* {
		reverse_proxy api:3001
	}
	handle {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
}
